{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "When_a_message_is_received_in_a_queue_(peek-lock)": {
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "referenceName": "servicebus"
                        }
                    },
                    "method": "get",
                    "path": "/@{encodeURIComponent(encodeURIComponent('catches-products-queue'))}/messages/head/peek",
                    "queries": {
                        "queueType": "Main",
                        "sessionId": "Next Available"
                    }
                },
                "recurrence": {
                    "interval": 30,
                    "frequency": "Second"
                },
                "correlation": {
                    "clientTrackingId": "@coalesce(triggerBody()?['CorrelationId'], triggerBody()?['Properties']?['correlationId'], guid())"
                },
                "conditions": [],
                "runtimeConfiguration": {
                    "concurrency": {
                        "runs": 2
                    }
                }
            }
        },
        "actions": {
            "Parse_Payload_to_Object": {
                "type": "Compose",
                "description": "Parse the queue message payload into an object for catches/products processing.",
                "inputs": "@json(base64ToString(triggerBody()?['ContentData']))",
                "runAfter": {}
            },
            "Initialise_Payload": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "Payload",
                            "type": "object",
                            "value": {}
                        }
                    ]
                },
                "runAfter": {
                    "Parse_Payload_to_Object": [
                        "Succeeded"
                    ]
                }
            },
            "Initialise_Catches_Products_Array": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "CatchesProductsArray",
                            "type": "array",
                            "value": []
                        }
                    ]
                },
                "runAfter": {
                    "Initialise_Payload": [
                        "Succeeded"
                    ]
                }
            },
            "Initialise_DocumentId": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "DocumentId",
                            "type": "string"
                        }
                    ]
                },
                "runAfter": {
                    "Initialise_Catches_Products_Array": [
                        "Succeeded"
                    ]
                }
            },
            "Initialise_CaseId": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "CaseId",
                            "type": "string"
                        }
                    ]
                },
                "runAfter": {
                    "Initialise_DocumentId": [
                        "Succeeded"
                    ]
                }
            },
            "Initialise_CorrelationId": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "CorrelationId",
                            "type": "string"
                        }
                    ]
                },
                "runAfter": {
                    "Initialise_CaseId": [
                        "Succeeded"
                    ]
                }
            },
            "Initialise_DocumentNumber": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "DocumentNumber",
                            "type": "string"
                        }
                    ]
                },
                "runAfter": {
                    "Initialise_CorrelationId": [
                        "Succeeded"
                    ]
                }
            },
            "Initialise_ErrorMessage": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "ErrorMessage",
                            "type": "string"
                        }
                    ]
                },
                "runAfter": {
                    "Initialise_DocumentNumber": [
                        "Succeeded"
                    ]
                }
            },
            "Process_Catches_Products_And_Complete": {
                "type": "Scope",
                "description": "Stage 3 of the split: apply catches/products parity logic, set document process status to Completed, then settle the source queue message.",
                "actions": {
                    "Set_Payload": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "Payload",
                            "value": "@if(contains(outputs('Parse_Payload_to_Object'),'payload'),outputs('Parse_Payload_to_Object')['payload'],outputs('Parse_Payload_to_Object'))"
                        }
                    },
                    "Set_Catches_Products_Array": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "CatchesProductsArray",
                            "value": "@if( contains(variables('Payload'), 'catches'), variables('Payload')['catches'], if( contains(variables('Payload'), 'products'), variables('Payload')['products'], json('[]')))"
                        },
                        "runAfter": {
                            "Set_Payload": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Set_DocumentId": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "DocumentId",
                            "value": "@coalesce(outputs('Parse_Payload_to_Object')?['documentId'], variables('Payload')?['documentId'], '')"
                        },
                        "runAfter": {
                            "Set_Catches_Products_Array": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Set_CaseId": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "CaseId",
                            "value": "@coalesce(outputs('Parse_Payload_to_Object')?['caseId'], variables('Payload')?['caseId'], '')"
                        },
                        "runAfter": {
                            "Set_DocumentId": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Set_CorrelationId": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "CorrelationId",
                            "value": "@coalesce(outputs('Parse_Payload_to_Object')?['correlationId'], trigger().clientTrackingId, '')"
                        },
                        "runAfter": {
                            "Set_CaseId": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Set_DocumentNumber": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "DocumentNumber",
                            "value": "@coalesce(outputs('Parse_Payload_to_Object')?['documentNumber'], variables('Payload')?['documentNumber'], '')"
                        },
                        "runAfter": {
                            "Set_CorrelationId": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Create_or_Update_Catches_Products": {
                        "type": "Scope",
                        "actions": {
                            "For_Each_CatchProduct": {
                                "type": "Foreach",
                                "foreach": "@variables('CatchesProductsArray')",
                                "actions": {
                                    "Has_Existing_CatchProduct": {
                                        "type": "If",
                                        "expression": {
                                            "and": [
                                                {
                                                    "equals": [
                                                        "@length(body('Query_Existing_CatchProduct')?['value'])",
                                                        0
                                                    ]
                                                }
                                            ]
                                        },
                                        "actions": {
                                            "CaseId_Is_Empty": {
                                                "type": "If",
                                                "expression": {
                                                    "and": [
                                                        {
                                                            "equals": [
                                                                "@variables('CaseId')",
                                                                ""
                                                            ]
                                                        }
                                                    ]
                                                },
                                                "actions": {
                                                    "Create_Incident": {
                                                        "type": "ApiConnection",
                                                        "inputs": {
                                                            "host": {
                                                                "connection": {
                                                                    "referenceName": "commondataservice"
                                                                }
                                                            },
                                                            "method": "post",
                                                            "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('HostUrl')))}/tables/@{encodeURIComponent(encodeURIComponent('incidents'))}/items"
                                                        },
                                                        "trackedProperties": {
                                                            "correlationId": "@{coalesce(trigger().clientTrackingId, triggerBody()?['CorrelationId'], triggerBody()?['Properties']?['correlationId'], '')}",
                                                            "documentNumber": "@{coalesce(json(base64ToString(triggerBody()?['ContentData']))?['documentNumber'], json(base64ToString(triggerBody()?['ContentData']))?['payload']?['documentNumber'], '')}",
                                                            "stage": "catches-products-processing",
                                                            "entity": "case",
                                                            "entityAction": "create",
                                                            "message": "Created case record for catches/products processing"
                                                        }
                                                    },
                                                    "Set_CaseId_From_Incident": {
                                                        "type": "SetVariable",
                                                        "inputs": {
                                                            "name": "CaseId",
                                                            "value": "@body('Create_Incident')?['incidentid']"
                                                        },
                                                        "runAfter": {
                                                            "Create_Incident": [
                                                                "Succeeded",
                                                                "Failed"
                                                            ]
                                                        }
                                                    }
                                                },
                                                "else": {
                                                    "actions": {}
                                                }
                                            },
                                            "Create_CatchProduct": {
                                                "type": "ApiConnection",
                                                "inputs": {
                                                    "host": {
                                                        "connection": {
                                                            "referenceName": "commondataservice"
                                                        }
                                                    },
                                                    "method": "post",
                                                    "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('HostUrl')))}/tables/@{encodeURIComponent(encodeURIComponent('mmofe_catchproducts'))}/items"
                                                },
                                                "runAfter": {
                                                    "ValidationStatusId_CP": [
                                                        "Succeeded"
                                                    ]
                                                },
                                                "trackedProperties": {
                                                    "correlationId": "@{coalesce(trigger().clientTrackingId, triggerBody()?['CorrelationId'], triggerBody()?['Properties']?['correlationId'], '')}",
                                                    "documentNumber": "@{coalesce(json(base64ToString(triggerBody()?['ContentData']))?['documentNumber'], json(base64ToString(triggerBody()?['ContentData']))?['payload']?['documentNumber'], '')}",
                                                    "stage": "catches-products-processing",
                                                    "entity": "catchProduct",
                                                    "entityAction": "create",
                                                    "message": "@{concat('Created catch/product record for item id ', coalesce(json(base64ToString(triggerBody()?['ContentData']))?['payload']?['catches']?[0]?['id'], json(base64ToString(triggerBody()?['ContentData']))?['payload']?['products']?[0]?['id'], json(base64ToString(triggerBody()?['ContentData']))?['catches']?[0]?['id'], json(base64ToString(triggerBody()?['ContentData']))?['products']?[0]?['id'], 'unknown'))}"
                                                }
                                            },
                                            "Get_Species_for_CP": {
                                                "type": "ApiConnection",
                                                "inputs": {
                                                    "host": {
                                                        "connection": {
                                                            "referenceName": "commondataservice"
                                                        }
                                                    },
                                                    "method": "get",
                                                    "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('HostUrl')))}/tables/@{encodeURIComponent(encodeURIComponent('mmofe_species'))}/items",
                                                    "queries": {
                                                        "$filter": "mmofe_name eq '@{item()['species']}'",
                                                        "$top": 1,
                                                        "$select": "mmofe_specieid"
                                                    }
                                                },
                                                "runAfter": {
                                                    "CaseId_Is_Empty": [
                                                        "Succeeded"
                                                    ]
                                                }
                                            },
                                            "Get_Validation_Status_for_CP": {
                                                "type": "ApiConnection",
                                                "inputs": {
                                                    "host": {
                                                        "connection": {
                                                            "referenceName": "commondataservice"
                                                        }
                                                    },
                                                    "method": "get",
                                                    "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('HostUrl')))}/tables/@{encodeURIComponent(encodeURIComponent('mmofe_validationstatuses'))}/items",
                                                    "queries": {
                                                        "$filter": "mmofe_name eq '@{if(contains(string(item()),'status'), json(string(item()['validation']))['status'],'')}'",
                                                        "$top": 1,
                                                        "$select": "mmofe_validationstatusid"
                                                    }
                                                },
                                                "runAfter": {
                                                    "CaseId_Is_Empty": [
                                                        "Succeeded"
                                                    ]
                                                }
                                            },
                                            "SpeciesId_CP": {
                                                "type": "Compose",
                                                "inputs": "@if(greater(length(body('Get_Species_for_CP')?['value']),0), body('Get_Species_for_CP')?['value'][0]['mmofe_specieid'],null)",
                                                "runAfter": {
                                                    "Get_Species_for_CP": [
                                                        "Succeeded"
                                                    ],
                                                    "Get_Validation_Status_for_CP": [
                                                        "Succeeded"
                                                    ]
                                                }
                                            },
                                            "ValidationStatusId_CP": {
                                                "type": "Compose",
                                                "inputs": "@if(greater(length(body('Get_Validation_Status_for_CP')?['value']),0),body('Get_Validation_Status_for_CP')?['value'][0]['mmofe_validationstatusid'],null)",
                                                "runAfter": {
                                                    "SpeciesId_CP": [
                                                        "Succeeded"
                                                    ]
                                                }
                                            }
                                        },
                                        "else": {
                                            "actions": {}
                                        },
                                        "runAfter": {
                                            "Query_Existing_CatchProduct": [
                                                "Succeeded"
                                            ]
                                        }
                                    },
                                    "Query_Existing_CatchProduct": {
                                        "type": "ApiConnection",
                                        "inputs": {
                                            "host": {
                                                "connection": {
                                                    "referenceName": "commondataservice"
                                                }
                                            },
                                            "method": "get",
                                            "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('HostUrl')))}/tables/@{encodeURIComponent(encodeURIComponent('mmofe_catchproducts'))}/items",
                                            "queries": {
                                                "$filter": "_mmofe_documentid_value eq '@{variables('DocumentId')}' and mmofe_name eq '@{items('For_Each_CatchProduct')?['id']}'",
                                                "$top": 1,
                                                "$select": "mmofe_catchproductid"
                                            }
                                        },
                                        "trackedProperties": {
                                            "correlationId": "@{coalesce(trigger().clientTrackingId, triggerBody()?['CorrelationId'], triggerBody()?['Properties']?['correlationId'], '')}",
                                            "documentNumber": "@{coalesce(json(base64ToString(triggerBody()?['ContentData']))?['documentNumber'], json(base64ToString(triggerBody()?['ContentData']))?['payload']?['documentNumber'], '')}",
                                            "stage": "catches-products-processing",
                                            "entity": "catchProduct",
                                            "entityAction": "query-existing-record",
                                            "message": "@{concat('Queried catch/product record for item id ', coalesce(json(base64ToString(triggerBody()?['ContentData']))?['payload']?['catches']?[0]?['id'], json(base64ToString(triggerBody()?['ContentData']))?['payload']?['products']?[0]?['id'], json(base64ToString(triggerBody()?['ContentData']))?['catches']?[0]?['id'], json(base64ToString(triggerBody()?['ContentData']))?['products']?[0]?['id'], 'unknown'))}"
                                        }
                                    }
                                },
                                "runtimeConfiguration": {
                                    "concurrency": {
                                        "repetitions": 1
                                    }
                                }
                            }
                        },
                        "runAfter": {
                            "Set_DocumentNumber": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Update_Document_Process_Status": {
                        "type": "ApiConnection",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "referenceName": "commondataservice"
                                }
                            },
                            "method": "patch",
                            "body": {
                                "mmofe_processstatus": 961040001,
                                "_ownerid_type": ""
                            },
                            "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('HostUrl')))}/tables/@{encodeURIComponent(encodeURIComponent('mmofe_documents'))}/items/@{encodeURIComponent(encodeURIComponent(variables('DocumentId')))}"
                        },
                        "runAfter": {
                            "Create_or_Update_Catches_Products": [
                                "Succeeded"
                            ]
                        },
                        "trackedProperties": {
                            "correlationId": "@{coalesce(trigger().clientTrackingId, triggerBody()?['CorrelationId'], triggerBody()?['Properties']?['correlationId'], '')}",
                            "documentNumber": "@{coalesce(json(base64ToString(triggerBody()?['ContentData']))?['documentNumber'], json(base64ToString(triggerBody()?['ContentData']))?['payload']?['documentNumber'], '')}",
                            "stage": "catches-products-processing",
                            "entity": "document",
                            "entityAction": "update-process-status",
                            "message": "Updated document process status to completed"
                        }
                    },
                    "Complete_the_message_in_a_queue": {
                        "type": "ApiConnection",
                        "description": "Settle the source catches/products queue message only after successful processing and document completion-status update.",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "referenceName": "servicebus"
                                }
                            },
                            "method": "delete",
                            "path": "/@{encodeURIComponent(encodeURIComponent('catches-products-queue'))}/messages/complete",
                            "queries": {
                                "lockToken": "@triggerBody()?['LockToken']",
                                "queueType": "Main",
                                "sessionId": "@triggerBody()?['SessionId']"
                            }
                        },
                        "runAfter": {
                            "Update_Document_Process_Status": [
                                "Succeeded"
                            ]
                        },
                        "trackedProperties": {
                            "correlationId": "@{coalesce(trigger().clientTrackingId, triggerBody()?['CorrelationId'], triggerBody()?['Properties']?['correlationId'], '')}",
                            "documentNumber": "@{coalesce(json(base64ToString(triggerBody()?['ContentData']))?['documentNumber'], json(base64ToString(triggerBody()?['ContentData']))?['payload']?['documentNumber'], '')}",
                            "stage": "catches-products-processing",
                            "entity": "message",
                            "entityAction": "complete-source-message",
                            "message": "Completed source message from catches-products-queue",
                            "messageAction": "complete"
                        }
                    }
                },
                "runAfter": {
                    "Initialise_ErrorMessage": [
                        "Succeeded"
                    ]
                }
            },
            "Handle_Failure": {
                "type": "Scope",
                "description": "Error handler. If catches/products processing fails, abandon the source message for redelivery.",
                "actions": {
                    "Extract_Error_Details": {
                        "type": "Compose",
                        "description": "Capture the full scope result for failure diagnostics.",
                        "inputs": "@{string(result('Process_Catches_Products_And_Complete'))}"
                    },
                    "Set_ErrorMessage": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "ErrorMessage",
                            "value": "@{outputs('Extract_Error_Details')}"
                        },
                        "runAfter": {
                            "Extract_Error_Details": [
                                "Succeeded",
                                "Failed",
                                "Skipped"
                            ]
                        }
                    },
                    "Log_Failure": {
                        "type": "Compose",
                        "inputs": {
                            "correlationId": "@coalesce(variables('CorrelationId'), trigger().clientTrackingId)",
                            "documentId": "@variables('DocumentId')",
                            "documentNumber": "@variables('DocumentNumber')",
                            "caseId": "@variables('CaseId')",
                            "stage": "catches-products-processing",
                            "outcome": "failed",
                            "messageAction": "abandon",
                            "errorMessage": "@variables('ErrorMessage')",
                            "result": "@result('Process_Catches_Products_And_Complete')"
                        },
                        "runAfter": {
                            "Set_ErrorMessage": [
                                "Succeeded",
                                "Failed",
                                "Skipped"
                            ]
                        },
                        "trackedProperties": {
                            "correlationId": "@{coalesce(trigger().clientTrackingId, triggerBody()?['CorrelationId'], triggerBody()?['Properties']?['correlationId'], '')}",
                            "documentNumber": "@{coalesce(json(base64ToString(triggerBody()?['ContentData']))?['documentNumber'], json(base64ToString(triggerBody()?['ContentData']))?['payload']?['documentNumber'], '')}",
                            "stage": "catches-products-processing",
                            "entity": "workflow",
                            "entityAction": "failure-log",
                            "message": "Failure logged for catches-products-processing scope",
                            "outcome": "failed"
                        }
                    },
                    "Abandon_the_message_in_a_queue": {
                        "type": "ApiConnection",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "referenceName": "servicebus"
                                }
                            },
                            "method": "post",
                            "path": "/@{encodeURIComponent(encodeURIComponent('catches-products-queue'))}/messages/abandon",
                            "queries": {
                                "lockToken": "@triggerBody()?['LockToken']",
                                "queueType": "Main",
                                "sessionId": "@triggerBody()?['SessionId']"
                            }
                        },
                        "runAfter": {
                            "Log_Failure": [
                                "Succeeded"
                            ]
                        },
                        "trackedProperties": {
                            "correlationId": "@{coalesce(trigger().clientTrackingId, triggerBody()?['CorrelationId'], triggerBody()?['Properties']?['correlationId'], '')}",
                            "documentNumber": "@{coalesce(json(base64ToString(triggerBody()?['ContentData']))?['documentNumber'], json(base64ToString(triggerBody()?['ContentData']))?['payload']?['documentNumber'], '')}",
                            "stage": "catches-products-processing",
                            "entity": "message",
                            "entityAction": "abandon-source-message",
                            "message": "Abandoned source message from catches-products-queue",
                            "messageAction": "abandon"
                        }
                    },
                    "Terminate_with_Failure": {
                        "type": "Terminate",
                        "description": "Fail the run so errors are explicit in run history and observability tools.",
                        "inputs": {
                            "runStatus": "Failed",
                            "runError": {
                                "code": "WorkflowFailed",
                                "message": "@{concat('Stage: catches-products-processing | Document: ', coalesce(json(base64ToString(triggerBody()?['ContentData']))?['documentNumber'], json(base64ToString(triggerBody()?['ContentData']))?['payload']?['documentNumber'], 'unknown'), ' | Result: ', string(result('Process_Catches_Products_And_Complete')))}"
                            }
                        },
                        "runAfter": {
                            "Abandon_the_message_in_a_queue": [
                                "Succeeded",
                                "Failed"
                            ]
                        }
                    }
                },
                "runAfter": {
                    "Process_Catches_Products_And_Complete": [
                        "Failed",
                        "Skipped",
                        "TimedOut"
                    ]
                }
            }
        },
        "outputs": {}
    },
    "kind": "Stateful"
}