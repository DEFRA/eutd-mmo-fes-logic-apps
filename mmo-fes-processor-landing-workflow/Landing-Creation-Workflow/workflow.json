{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "On_new_messages_from_queue_session": {
                "type": "ServiceProvider",
                "kind": "Polling",
                "inputs": {
                    "parameters": {
                        "queueName": "landing-queue"
                    },
                    "serviceProviderConfiguration": {
                        "connectionName": "serviceBus-1",
                        "operationId": "onNewMessagesFromQueueSession",
                        "serviceProviderId": "/serviceProviders/serviceBus"
                    }
                },
                "recurrence": {
                    "interval": 1,
                    "frequency": "Second"
                },
                "runtimeConfiguration": {
                    "concurrency": {
                        "runs": 2
                    }
                },
                "splitOn": "@triggerOutputs()?['body']"
            }
        },
        "actions": {
            "Parse_Payload_to_Object": {
                "type": "Compose",
                "description": "Parse the queue message payload into an object for landing processing.",
                "inputs": "@triggerBody()?['contentData']?['payload']",
                "runAfter": {
                    "Compose": [
                        "SUCCEEDED"
                    ]
                }
            },
            "Initialise_Payload": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "Payload",
                            "type": "object",
                            "value": {}
                        }
                    ]
                },
                "runAfter": {
                    "Parse_Payload_to_Object": [
                        "SUCCEEDED"
                    ]
                }
            },
            "Initialise_Landings_Array": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "Landings",
                            "type": "array",
                            "value": []
                        }
                    ]
                },
                "runAfter": {
                    "Initialise_Payload": [
                        "Succeeded"
                    ]
                }
            },
            "Initialise_Enriched_Landings_Array": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "EnrichedLandings",
                            "type": "array",
                            "value": []
                        }
                    ]
                },
                "runAfter": {
                    "Initialise_Landings_Array": [
                        "Succeeded"
                    ]
                }
            },
            "Initialise_DocumentId": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "DocumentId",
                            "type": "string"
                        }
                    ]
                },
                "runAfter": {
                    "Initialise_Enriched_Landings_Array": [
                        "Succeeded"
                    ]
                }
            },
            "Initialise_CaseId": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "CaseId",
                            "type": "string"
                        }
                    ]
                },
                "runAfter": {
                    "Initialise_DocumentId": [
                        "Succeeded"
                    ]
                }
            },
            "Initialise_CustomerId": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "CustomerId",
                            "type": "string"
                        }
                    ]
                },
                "runAfter": {
                    "Initialise_CaseId": [
                        "Succeeded"
                    ]
                }
            },
            "Initialise_CustomerIdType": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "CustomerIdType",
                            "type": "string"
                        }
                    ]
                },
                "runAfter": {
                    "Initialise_CustomerId": [
                        "Succeeded"
                    ]
                }
            },
            "Initialise_CorrelationId": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "CorrelationId",
                            "type": "string"
                        }
                    ]
                },
                "runAfter": {
                    "Initialise_CustomerIdType": [
                        "Succeeded"
                    ]
                }
            },
            "Initialise_Iteration": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "Iteration",
                            "type": "integer",
                            "value": 0
                        }
                    ]
                },
                "runAfter": {
                    "Initialise_CorrelationId": [
                        "Succeeded"
                    ]
                }
            },
            "Initialise_ErrorMessage": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "ErrorMessage",
                            "type": "string"
                        }
                    ]
                },
                "runAfter": {
                    "Initialise_Iteration": [
                        "Succeeded"
                    ]
                }
            },
            "Process_Landings_And_Complete": {
                "type": "Scope",
                "description": "Stage 2 of the split: apply complete landing create/update logic and settle the source queue message on success.",
                "actions": {
                    "Set_Payload": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "Payload",
                            "value": "@coalesce(outputs('Parse_Payload_to_Object'), json('{}'))"
                        }
                    },
                    "Set_Landings_Array": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "Landings",
                            "value": "@coalesce(\n  variables('Payload')?['landings'],\n  json('[]')\n)"
                        },
                        "runAfter": {
                            "Set_Payload": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Set_DocumentId": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "DocumentId",
                            "value": "@coalesce(triggerBody()?['contentData']?['documentId'],'')"
                        },
                        "runAfter": {
                            "Set_Landings_Array": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Set_CaseId": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "CaseId",
                            "value": "@coalesce(\n triggerBody()?['contentData']?['caseId'],\n ''\n)"
                        },
                        "runAfter": {
                            "Set_DocumentId": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Set_CustomerId": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "CustomerId",
                            "value": "@coalesce(outputs('Parse_Payload_to_Object')?['customerId'],'')"
                        },
                        "runAfter": {
                            "Set_CaseId": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Set_CustomerIdType": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "CustomerIdType",
                            "value": "@coalesce(\n triggerBody()?['contentData']?['customerIdType'],\n ''\n)"
                        },
                        "runAfter": {
                            "Set_CustomerId": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Set_CorrelationId": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "CorrelationId",
                            "value": "@coalesce(\n triggerBody()?['contentData']?['correlationId'],\n trigger().clientTrackingId,\n ''\n)"
                        },
                        "runAfter": {
                            "Set_CustomerIdType": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Set_Iteration": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "Iteration",
                            "value": "@int(\n coalesce(\n  triggerBody()?['contentData']?['iteration'],\n  0\n )\n)"
                        },
                        "runAfter": {
                            "Set_CorrelationId": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Prepare_Landings_For_Worker": {
                        "type": "Scope",
                        "actions": {
                            "For_Each_Landing": {
                                "type": "Foreach",
                                "foreach": "@variables('Landings')",
                                "actions": {
                                    "Get_Landing_Status": {
                                        "type": "Http",
                                        "inputs": {
                                            "uri": "@{parameters('BlobStorage')}/mmorefdata(PartitionKey='LandingStatus',RowKey='@{encodeURIComponent(items('For_Each_Landing')['status'])}')",
                                            "method": "GET",
                                            "headers": {
                                                "Accept": "application/json",
                                                "x-ms-version": "2019-07-07"
                                            },
                                            "authentication": {
                                                "audience": "https://storage.azure.com",
                                                "type": "ManagedServiceIdentity",
                                                "identity": "@appsetting('MANAGED_IDENTITY_RESOURCE_ID')"
                                            },
                                            "retryPolicy": {
                                                "type": "exponential",
                                                "count": 3,
                                                "interval": "PT7S"
                                            }
                                        }
                                    },
                                    "Get_Presentation": {
                                        "type": "Http",
                                        "inputs": {
                                            "uri": "@{parameters('BlobStorage')}/mmorefdata(PartitionKey='Presentation',RowKey='@{encodeURIComponent(items('For_Each_Landing')['presentation'])}')",
                                            "method": "GET",
                                            "headers": {
                                                "Accept": "application/json",
                                                "x-ms-version": "2019-07-07"
                                            },
                                            "queries": {
                                                "PartitionKey": "Presentation",
                                                "RowKey": "@{items('For_Each_Landing')['presentation']}"
                                            },
                                            "authentication": {
                                                "audience": "https://storage.azure.com",
                                                "type": "ManagedServiceIdentity",
                                                "identity": "@appsetting('MANAGED_IDENTITY_RESOURCE_ID')"
                                            },
                                            "path": "/Tables/@{encodeURIComponent('mmorefdata')}/entities(PartitionKey='@{encodeURIComponent('Presentation')}',RowKey='@{encodeURIComponent(items('For_Each_Landing')['presentation'])}')",
                                            "retryPolicy": {
                                                "type": "exponential",
                                                "count": 3,
                                                "interval": "PT7S"
                                            }
                                        }
                                    },
                                    "Get_Species": {
                                        "type": "Http",
                                        "inputs": {
                                            "uri": "@{parameters('BlobStorage')}/mmorefdata(PartitionKey='Species',RowKey='@{encodeURIComponent(items('For_Each_Landing')['species'])}')",
                                            "method": "GET",
                                            "headers": {
                                                "Accept": "application/json",
                                                "x-ms-version": "2019-07-07"
                                            },
                                            "authentication": {
                                                "audience": "https://storage.azure.com",
                                                "type": "ManagedServiceIdentity",
                                                "identity": "@appsetting('MANAGED_IDENTITY_RESOURCE_ID')"
                                            },
                                            "retryPolicy": {
                                                "type": "exponential",
                                                "count": 3,
                                                "interval": "PT7S"
                                            }
                                        }
                                    },
                                    "Get_State": {
                                        "type": "Http",
                                        "inputs": {
                                            "uri": "@{parameters('BlobStorage')}/mmorefdata(PartitionKey='State',RowKey='@{encodeURIComponent(items('For_Each_Landing')['state'])}')",
                                            "method": "GET",
                                            "headers": {
                                                "Accept": "application/json",
                                                "x-ms-version": "2019-07-07"
                                            },
                                            "authentication": {
                                                "audience": "https://storage.azure.com",
                                                "type": "ManagedServiceIdentity",
                                                "identity": "@appsetting('MANAGED_IDENTITY_RESOURCE_ID')"
                                            },
                                            "retryPolicy": {
                                                "type": "exponential",
                                                "count": 3,
                                                "interval": "PT7S"
                                            }
                                        }
                                    },
                                    "Source": {
                                        "type": "Compose",
                                        "inputs": "@if(empty(item()?['source']),null,if(equals(item()?['source'],'LANDING_DECLARATION'),961040001,if(equals(item()?['source'],'CATCH_RECORDING'),961040002,if(equals(item()?['source'],'ELOG'),961040000,null))))"
                                    },
                                    "NumberOfTotalSubmission": {
                                        "type": "Compose",
                                        "inputs": "@if(contains(item(),'numberOfTotalSubmissions'), item()['numberOfTotalSubmissions'],null)"
                                    },
                                    "Query_Existing_Landing": {
                                        "type": "ApiConnection",
                                        "inputs": {
                                            "host": {
                                                "connection": {
                                                    "referenceName": "commondataservice"
                                                }
                                            },
                                            "method": "get",
                                            "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('HostUrl')))}/tables/@{encodeURIComponent(encodeURIComponent('mmofe_landingses'))}/items",
                                            "queries": {
                                                "$filter": "_mmofe_documentid_value eq '@{variables('DocumentId')}' and mmofe_name eq '@{items('For_Each_Landing')['id']}'",
                                                "$top": 1,
                                                "$select": "mmofe_landingsid,mmofe_late,mmofe_liveexportweight,mmofe_sourcedata,_mmofe_caseid_value"
                                            }
                                        },
                                        "runAfter": {
                                            "NumberOfTotalSubmission": [
                                                "Succeeded"
                                            ]
                                        }
                                    },
                                    "PresentationId": {
                                        "type": "Compose",
                                        "inputs": "@body('Get_Presentation')['id']",
                                        "runAfter": {
                                            "Get_Presentation": [
                                                "Succeeded"
                                            ]
                                        }
                                    },
                                    "SpeciesId": {
                                        "type": "Compose",
                                        "inputs": "@body('Get_Species')['id']",
                                        "runAfter": {
                                            "Get_Species": [
                                                "Succeeded"
                                            ]
                                        }
                                    },
                                    "StateId": {
                                        "type": "Compose",
                                        "inputs": "@body('Get_State')['id']",
                                        "runAfter": {
                                            "Get_State": [
                                                "Succeeded"
                                            ]
                                        }
                                    },
                                    "ValidationStatusId": {
                                        "type": "Compose",
                                        "inputs": "@body('Get_Landing_Status')['id']",
                                        "runAfter": {
                                            "Get_Landing_Status": [
                                                "Succeeded"
                                            ]
                                        }
                                    },
                                    "ValidationStatusRetro": {
                                        "type": "Compose",
                                        "inputs": "@if(and(or(equals('7d04d01c-d38f-ee11-8179-6045bd905f18', body('Get_Landing_Status')?['id']), equals('3805cb04-d38f-ee11-8179-6045bd905f18', body('Get_Landing_Status')?['id']), equals('954f914e-cd8e-ee11-8179-6045bd905d39', body('Get_Landing_Status')?['id'])),equals(item()['landingOutcomeAtSubmission'],'Success'), equals(item()['is14DayLimitReached'],false) ,true), '83770889-abc5-ea11-a812-000d3a20caa3', '')",
                                        "runAfter": {
                                            "Get_Landing_Status": [
                                                "Succeeded"
                                            ]
                                        }
                                    },
                                    "VesselAdmin": {
                                        "type": "Compose",
                                        "inputs": "@if( contains(item(),'vesselAdministration'), if(equals(item()['vesselAdministration'],'England'),961040000, if(equals(item()['vesselAdministration'],'Scotland'),961040001,if(equals(item()['vesselAdministration'],'Wales'),961040002,if(equals(item()['vesselAdministration'],'Northern Ireland'),961040003,if(equals(item()['vesselAdministration'],'Isle of Man'),961040004,if(equals(item()['vesselAdministration'],'Jersey'),961040005,if(equals(item()['vesselAdministration'],'Guernsey'),961040006,null))))))),null)",
                                        "runAfter": {
                                            "Source": [
                                                "Succeeded"
                                            ]
                                        }
                                    },
                                    "PreparedLanding": {
                                        "type": "Compose",
                                        "inputs": {
                                            "source": "@outputs('Source')",
                                            "numberOfTotalSubmission": "@outputs('NumberOfTotalSubmission')",
                                            "presentationId": "@outputs('PresentationId')",
                                            "speciesId": "@outputs('SpeciesId')",
                                            "stateId": "@outputs('StateId')",
                                            "validationStatusId": "@outputs('ValidationStatusId')",
                                            "validationStatusRetro": "@outputs('ValidationStatusRetro')",
                                            "vesselAdmin": "@outputs('VesselAdmin')"
                                        },
                                        "runAfter": {
                                            "NumberOfTotalSubmission": [
                                                "Succeeded"
                                            ],
                                            "PresentationId": [
                                                "Succeeded"
                                            ],
                                            "SpeciesId": [
                                                "Succeeded"
                                            ],
                                            "StateId": [
                                                "Succeeded"
                                            ],
                                            "ValidationStatusId": [
                                                "Succeeded"
                                            ],
                                            "ValidationStatusRetro": [
                                                "Succeeded"
                                            ],
                                            "VesselAdmin": [
                                                "Succeeded"
                                            ]
                                        }
                                    },
                                    "Append_Enriched_Landing": {
                                        "type": "AppendToArrayVariable",
                                        "inputs": {
                                            "name": "EnrichedLandings",
                                            "value": "@setProperty(setProperty(item(), '_prepared', outputs('PreparedLanding')), '_existingRecords', coalesce(body('Query_Existing_Landing')?['value'], createArray()))"
                                        },
                                        "runAfter": {
                                            "PreparedLanding": [
                                                "Succeeded"
                                            ],
                                            "Query_Existing_Landing": [
                                                "Succeeded"
                                            ],
                                            "PresentationId": [
                                                "Succeeded"
                                            ],
                                            "SpeciesId": [
                                                "Succeeded"
                                            ],
                                            "StateId": [
                                                "Succeeded"
                                            ],
                                            "ValidationStatusId": [
                                                "Succeeded"
                                            ],
                                            "ValidationStatusRetro": [
                                                "Succeeded"
                                            ],
                                            "VesselAdmin": [
                                                "Succeeded"
                                            ]
                                        }
                                    }
                                },
                                "runtimeConfiguration": {
                                    "concurrency": {
                                        "repetitions": 1
                                    }
                                }
                            }
                        },
                        "runAfter": {
                            "Set_Iteration": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Build_Handoff_Message": {
                        "type": "Compose",
                        "description": "Versioned hand-off envelope published to landing2_queue for async create/update worker processing.",
                        "inputs": {
                            "schemaVersion": "1.0",
                            "messageType": "LandingCreateUpdateRequested",
                            "stage": "landing-dispatch",
                            "correlationId": "@variables('CorrelationId')",
                            "documentNumber": "@coalesce(outputs('Parse_Payload_to_Object')?['documentNumber'], variables('Payload')?['documentNumber'], variables('Payload')?['landings']?[0]?['documentNumber'], '')",
                            "idempotencyKey": "@{coalesce(outputs('Parse_Payload_to_Object')?['documentNumber'], variables('Payload')?['documentNumber'], variables('Payload')?['landings']?[0]?['documentNumber'], 'unknown')}-@{string(variables('Iteration'))}",
                            "documentId": "@variables('DocumentId')",
                            "caseId": "@variables('CaseId')",
                            "customerId": "@variables('CustomerId')",
                            "customerIdType": "@variables('CustomerIdType')",
                            "caseTypeId": "@coalesce(outputs('Parse_Payload_to_Object')?['caseTypeId'], '')",
                            "caseTypeId2": "@coalesce(outputs('Parse_Payload_to_Object')?['caseTypeId2'], '')",
                            "caseStatusAtSubmission": "@coalesce(outputs('Parse_Payload_to_Object')?['caseStatusAtSubmission'], '')",
                            "devolvedAdministrationId": "@coalesce(outputs('Parse_Payload_to_Object')?['devolvedAdministrationId'], '')",
                            "cloneDocId": "@coalesce(outputs('Parse_Payload_to_Object')?['cloneDocId'], '')",
                            "iteration": "@variables('Iteration')",
                            "numberOfFailedSubmissions": "@int(coalesce(outputs('Parse_Payload_to_Object')?['numberOfFailedSubmissions'], 0))",
                            "payload": "@setProperty(variables('Payload'), 'enrichedLandings', variables('EnrichedLandings'))"
                        },
                        "runAfter": {
                            "Prepare_Landings_For_Worker": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Publish_to_landing_createandupdate_queue": {
                        "type": "ApiConnection",
                        "description": "Send the landing hand-off envelope to the create/update worker queue.",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "referenceName": "servicebus"
                                }
                            },
                            "method": "post",
                            "body": {
                                "SessionId": "@coalesce(outputs('Parse_Payload_to_Object')?['documentNumber'], variables('Payload')?['documentNumber'], variables('Payload')?['landings']?[0]?['documentNumber'], triggerBody()?['SessionId'])",
                                "CorrelationId": "@variables('CorrelationId')",
                                "ContentData": "@{base64(string(outputs('Build_Handoff_Message')))}",
                                "ContentType": "application/json",
                                "Properties": {
                                    "correlationId": "@variables('CorrelationId')",
                                    "documentNumber": "@coalesce(outputs('Parse_Payload_to_Object')?['documentNumber'], variables('Payload')?['documentNumber'], variables('Payload')?['landings']?[0]?['documentNumber'], '')",
                                    "stage": "landing-dispatch",
                                    "messageType": "LandingCreateUpdateRequested"
                                }
                            },
                            "path": "/@{encodeURIComponent(encodeURIComponent('landing2_queue'))}/messages"
                        },
                        "runAfter": {
                            "Build_Handoff_Message": [
                                "Succeeded"
                            ]
                        },
                        "trackedProperties": {
                            "correlationId": "@{coalesce(trigger().clientTrackingId, triggerBody()?['CorrelationId'], triggerBody()?['Properties']?['correlationId'], '')}",
                            "documentNumber": "@{coalesce( triggerBody()?['contentData']?['payload']?['documentNumber'], '' )}",
                            "stage": "landing-dispatch",
                            "entity": "message",
                            "entityAction": "publish-create-update",
                            "message": "@{concat( 'Published handoff message to landing2_queue for landing id ', coalesce( triggerBody()?['contentData']?['payload']?['landings']?[0]?['id'], 'unknown' ) )}",
                            "messageAction": "handoff"
                        }
                    },
                    "Complete_the_message_in_a_session": {
                        "type": "ServiceProvider",
                        "inputs": {
                            "parameters": {
                                "messageId": "@triggerBody()?['messageId']",
                                "lockToken": "@triggerBody()?['lockToken']"
                            },
                            "serviceProviderConfiguration": {
                                "connectionName": "serviceBus-1",
                                "operationId": "completeMessageInSession",
                                "serviceProviderId": "/serviceProviders/serviceBus"
                            }
                        },
                        "runAfter": {
                            "Publish_to_landing_createandupdate_queue": [
                                "SUCCEEDED"
                            ]
                        }
                    }
                },
                "runAfter": {
                    "Initialise_ErrorMessage": [
                        "Succeeded"
                    ]
                }
            },
            "Handle_Failure": {
                "type": "Scope",
                "description": "Error handler. If landing processing fails, abandon the source message for redelivery.",
                "actions": {
                    "Extract_Error_Details": {
                        "type": "Compose",
                        "description": "Capture the full scope result for failure diagnostics.",
                        "inputs": "@{string(result('Process_Landings_And_Complete'))}"
                    },
                    "Set_ErrorMessage": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "ErrorMessage",
                            "value": "@{outputs('Extract_Error_Details')}"
                        },
                        "runAfter": {
                            "Extract_Error_Details": [
                                "Succeeded",
                                "Failed",
                                "Skipped"
                            ]
                        }
                    },
                    "Log_Failure": {
                        "type": "Compose",
                        "inputs": {
                            "correlationId": "@coalesce(variables('CorrelationId'), trigger().clientTrackingId)",
                            "documentId": "@variables('DocumentId')",
                            "caseId": "@variables('CaseId')",
                            "stage": "landing-creation",
                            "outcome": "failed",
                            "messageAction": "abandon",
                            "errorMessage": "@variables('ErrorMessage')",
                            "result": "@result('Process_Landings_And_Complete')"
                        },
                        "runAfter": {
                            "Set_ErrorMessage": [
                                "Succeeded",
                                "Failed",
                                "Skipped"
                            ]
                        },
                        "trackedProperties": {
                            "correlationId": "@{coalesce(trigger().clientTrackingId, '')}",
                            "documentNumber": "@{coalesce(triggerBody()?['contentData']?['payload']?['documentNumber'], '')}",
                            "landingId": "@{coalesce(triggerBody()?['contentData']?['payload']?['landings']?[0]?['id'], '')}",
                            "stage": "landing-creation",
                            "outcome": "failed"
                        }
                    },
                    "Terminate_with_Failure": {
                        "type": "Terminate",
                        "description": "Fail the run so errors are explicit in run history and observability tools.",
                        "inputs": {
                            "runStatus": "Failed",
                            "runError": {
                                "code": "WorkflowFailed",
                                "message": "@{concat('Stage: landing-creation | Document: ', coalesce(triggerBody()?['contentData']?['documentNumber'], triggerBody()?['contentData']?['payload']?['documentNumber'], 'unknown'), ' | Result: ', string(result('Process_Landings_And_Complete')))}"
                            }
                        },
                        "runAfter": {
                            "Abandon_the_message_in_a_session": [
                                "SUCCEEDED"
                            ]
                        }
                    },
                    "Abandon_the_message_in_a_session": {
                        "type": "ServiceProvider",
                        "inputs": {
                            "parameters": {
