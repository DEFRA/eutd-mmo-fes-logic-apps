						"runAfter": {
							"Publish_to_catches-products-queue": [
								"Succeeded"
							]
						},
						"trackedProperties": {
							"correlationId": "@{coalesce(trigger().clientTrackingId, triggerBody()?['CorrelationId'], triggerBody()?['Properties']?['correlationId'], '')}",
							"documentNumber": "@{coalesce(json(base64ToString(triggerBody()?['ContentData']))?['documentNumber'], json(base64ToString(triggerBody()?['ContentData']))?['payload']?['documentNumber'], json(base64ToString(triggerBody()?['ContentData']))?['payload']?['landings']?[0]?['documentNumber'], '')}",
							"stage": "landing-creation",
							"messageAction": "complete"
						}
					}
				},
				"runAfter": {
					"Initialize_Retrospective_Period_Complete": [
						"Succeeded"
					]
				}
			},
			"Handle_Failure": {
				"type": "Scope",
				"description": "Error handler. If landing processing fails, abandon the source message for redelivery.",
				"actions": {
					"Log_Failure": {
						"type": "Compose",
						"inputs": {
							"correlationId": "@coalesce(variables('CorrelationId'), trigger().clientTrackingId)",
							"documentId": "@variables('DocumentId')",
							"caseId": "@variables('CaseId')",
							"stage": "landing-creation",
							"outcome": "failed",
							"messageAction": "abandon",
							"result": "@result('Process_Landings_And_Complete')"
						},
						"runAfter": {}
					},
					"Abandon_the_message_in_a_queue": {
						"type": "ApiConnection",
						"inputs": {
							"host": {
								"connection": {
									"referenceName": "servicebus"
								}
							},
							"method": "post",
							"path": "/@{encodeURIComponent(encodeURIComponent('landing-queue'))}/messages/abandon",
							"queries": {
								"lockToken": "@triggerBody()?['LockToken']",
								"queueType": "Main",
								"sessionId": "@triggerBody()?['SessionId']"
							}
						},
						"runAfter": {
							"Log_Failure": [
								"Succeeded"
							]
						},
						"trackedProperties": {
							"correlationId": "@{coalesce(trigger().clientTrackingId, triggerBody()?['CorrelationId'], triggerBody()?['Properties']?['correlationId'], '')}",
							"documentId": "@{coalesce(json(base64ToString(triggerBody()?['ContentData']))?['documentId'], '')}",
							"stage": "landing-creation",
							"messageAction": "abandon"
						}
					}
				},
				"runAfter": {
					"Process_Landings_And_Complete": [
						"Failed",
						"Skipped",
						"TimedOut"
					]
				}
			}
		},
		"outputs": {}
	},
	"kind": "Stateful"
}